# ============================================================
# HotelScout Guinea — Docker Ignore
# Excludes unnecessary files from Docker build context
# ============================================================

# Dependencies
node_modules
.pnp
.pnp.js

# Next.js build output
.next
out

# Database files (will be mounted as volume)
db/*.db
db/*.db-journal
data/

# Debug logs
dev.log
server.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
bun-debug.log*

# Environment files (should be provided at runtime)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE
.vscode
.idea
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Download and output directories
download/
upload/
tool-results/

# Project-specific JSON data files (not needed in build)
search_*.json
verify_*.json
guinea_hotels_website_verification.json
search_hotels_*.mjs
update_hotels.py

# Agent context
agent-ctx/
skills/

# Git
.git
.gitignore

# Docker files (no recursion)
Dockerfile
docker-compose*.yml
.dockerignore

# Misc
worklog.md
eslint.config.mjs
README.md
