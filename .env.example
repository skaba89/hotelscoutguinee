# ─── Database ───────────────────────────────────────────────────────
# SQLite database path (Prisma)
DATABASE_URL="file:./db/custom.db"

# ─── Z-AI SDK ──────────────────────────────────────────────────────
# If .z-ai-config file is absent, these env vars are used as fallback.
ZAI_BASE_URL=""
ZAI_API_KEY=""

# ─── Security ──────────────────────────────────────────────────────
# AES-256-GCM encryption key for API keys (must be exactly 32 chars).
# CHANGE THIS in production — the default is insecure.
ENCRYPTION_KEY="hotelscout-guinea-default-key-32b!"

# ─── Authentication ────────────────────────────────────────────────
# Admin password for API authentication.
# If empty or not set, authentication is disabled (open access).
# Set a strong password in production to protect write operations.
ADMIN_PASSWORD=""

# ─── Cron Jobs ─────────────────────────────────────────────────────
# Shared secret to protect /api/cron/* endpoints from unauthorised calls.
# Must match the secret sent by your cron scheduler (e.g. Vercel Cron).
CRON_SECRET=""

# ─── CORS ──────────────────────────────────────────────────────────
# Allowed origin for CORS headers. Use "*" for development only.
ALLOWED_ORIGIN="*"
